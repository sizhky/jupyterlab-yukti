{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Yukti Cell Copy",
  "description": "Copy, freeze and hide buttons for the cell toolbar, and the two command mode keys that reach them.",
  "jupyter.lab.shortcuts": [
    {
      "command": "yukti:toggle-hidden",
      "keys": [
        "H"
      ],
      "selector": ".jp-Notebook.jp-mod-commandMode:not(.jp-mod-readWrite) :focus"
    },
    {
      "command": "yukti:toggle-freeze",
      "keys": [
        "F"
      ],
      "selector": ".jp-Notebook.jp-mod-commandMode:not(.jp-mod-readWrite) :focus"
    }
  ],
  "jupyter.lab.toolbars": {
    "Cell": [
      {
        "name": "yukti-copy-input",
        "command": "yukti:copy-input",
        "rank": 60
      },
      {
        "name": "yukti-copy-output",
        "command": "yukti:copy-output",
        "rank": 61
      },
      {
        "name": "yukti-copy-both",
        "command": "yukti:copy-both",
        "rank": 62
      },
      {
        "name": "yukti-freeze",
        "command": "yukti:toggle-freeze",
        "rank": 63
      },
      {
        "name": "yukti-hide",
        "command": "yukti:toggle-hidden",
        "rank": 64
      }
    ]
  },
  "properties": {},
  "additionalProperties": false,
  "type": "object"
}
