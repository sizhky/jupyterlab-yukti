	step=s2
	message=sync
	fragment=opt:no yuktiRoot
	operand=[the option is empty]
	operand_note=The plugin returns and the tab does not appear, because no path can be made absolute.
	note=target(): root/path
	description=A star press stores root/path for the selected item. A folder ends in a slash, and the root folder is root/.
	code=[bookmarksPlugin](../../yukti_frontend/src/index.ts){show=symbol symbol=bookmarksPlugin kind=Variable focus="match[PageConfig.getOption('yuktiRoot')] match[return dir === '' ? ]" context=2}
