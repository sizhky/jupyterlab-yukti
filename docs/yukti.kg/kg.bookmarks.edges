	step=s3
	pair=p-reach
	message=sync
	note=underRoot(path, root)
	description=bookmarkList asks for the reach of each stored path while it draws a row.
	code=[bookmarkList](../../yukti_frontend/src/index.ts){show=symbol symbol=bookmarkList kind=Function focus="match[bookmarkRow(path, underRoot(path, root), open, drop)]" context=2}
k4: under-root -> bookmarks-plugin returns
	step=s3
	pair=p-reach
	message=reply
	fragment=alt:where the path lies
	operand=[outside the root]
	operand_note=underRoot returns null. The row stays in the list and its open button is disabled, with a title that says the path is outside the root.
	note=path under root, or null
	description=An absolute path under the root returns the relative remainder, and the root itself returns a slash. A legacy relative path returns unchanged.
	code=[underRoot](../../yukti_frontend/src/index.ts){show=symbol symbol=underRoot kind=Function focus="match[if (!path.startsWith(`${root}/`)) {] match[return path.slice(root.length + 1) || '/';]" context=2}
