@graph id=yukti-ask title="One %%ask turn"
hover_attrs=description,code
pair_by=pair
edge_color_by=step
edge_label_from=note
default_view=ask

@sources
nodes=kg.nodes
attrs=kg.attrs
ask:
	edges=kg.edges
transcript:
	edges=kg.transcript.edges
claude:
	edges=kg.claude.edges
image:
	edges=kg.image.edges
action:
	edges=kg.action.edges
diff:
	edges=kg.diff.edges
palette=kg.palette
code_source=../../

@relations
sends color=relation.sends
takes color=relation.takes
builds color=relation.builds
streams color=relation.streams
returns color=relation.returns
limits color=relation.limits
closes color=relation.closes
checks color=relation.checks
translates color=relation.translates
starts color=relation.starts

@views
ask:
	source=ask
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=frontend,prefix-comm,ask-magic,app-server
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Four participants, one round trip. The prefix comm opens before the cell runs and closes after the answer, so its activation bar spans the whole turn. build_transcript and truncate are calls inside %%ask, not participants; the transcript view gives them their own lifelines."
	slides:
		receive: Steps 1 to 2 — take the prefix
			nodes=frontend,prefix-comm,ask-magic
			caption="The frontend sends one notebook_prefix message and does not wait. The comm holds it until the cell starts, then take() hands over the cells and the comm handle at once. An empty comm ends the turn in the break box."
		send: Step 3 — send one bounded request
			nodes=ask-magic,app-server
			caption="build_transcript turns the cells and the question into one string under 512 KB, and %%ask starts a Codex process with it. Open the transcript view to see the two limits that bound it."
		answer: Steps 4 to 6 — stream the answer back
			nodes=app-server,ask-magic,frontend,prefix-comm
			caption="The loop box holds every delta. Each one reaches %%ask first, which decides its block, then reaches the cell through display. A finally block closes the comm, so the frontend learns the turn is over either way."
transcript:
	source=transcript
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=ask-magic,transcript,output-boundary
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="A zoom into step 3 of the ask view. Here build_transcript and truncate earn lifelines, because this view is about the calls themselves. Two limits protect one turn: 8 KB per output, then 512 KB for the whole request."
	slides:
		outputs: Step 2 — bound every output
			nodes=transcript,output-boundary
			caption="The loop box runs once per cell above %%ask. Each output is cut to 8 KB before its block joins the request, so one long print cannot crowd out the other cells."
		request: Steps 3 to 4 — bound the whole request
			nodes=ask-magic,transcript,output-boundary
			caption="The blocks are joined, then a second call cuts the joined request to 512 KB. Many small cells can pass the first limit and still add up past this one, which is why both exist."
claude:
	source=claude
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=settings,ask-magic,claude-code,subscription-check,claude-cli,tool-item
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="The ask view with backend: claude. ClaudeCode replaces the Codex server behind the same run call. It checks the subscription login first, starts the user's own claude -p, answers the notebook tool calls in the kernel, and shows built-in tools as Codex items. Yukti never reads or forwards the OAuth credential."
	slides:
		choose: Steps 1 to 2 — pick the backend and check the login
			nodes=settings,ask-magic,claude-code,subscription-check,claude-cli
			caption="A backend line picks the class. Before any process starts, require_subscription asks the claude binary for the login. Anthropic permits subscription use only through the unmodified binary, so Yukti reads the report and never the credential."
		start: Step 3 — start the CLI
			nodes=claude-code,claude-cli
			caption="claude_command turns the settings into flags and registers the yukti sdk MCP server. One initialize request opens the control protocol."
		turn: Steps 4 to 6 — stream, answer tool calls, finish
			nodes=ask-magic,claude-code,claude-cli,tool-item
			caption="Deltas reach on_delta as in the Codex path. A notebook tool call arrives as a control request and is answered in the kernel. A built-in tool is allowed, translated to a Codex item and shown."
image:
	source=image
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=frontend,ask-magic,question-images,app-server,claude-code
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Proposed view, pending review: pasting an image into an %%ask cell. The paste saves a file and writes a Markdown reference into the cell. The turn reads the reference, checks the file, and hands the path to the backend in the form that backend accepts. trackImagePastes, turn_input and user_content are calls inside their owners, not participants."
	slides:
		paste: Step 1 - paste saves a file and a reference
			nodes=frontend,ask-magic
			caption="The paste handler saves the image under yukti-images next to the notebook and inserts a Markdown reference at the cursor. A code cell has no attachments, so the file is the only place the image can live."
		read: Steps 2 to 3 - read and check the paths
			nodes=ask-magic,question-images,frontend
			caption="question_images returns the paths in the cell. %%ask makes them absolute and stops with a UsageError when one file is missing."
		send: Step 4 - one image form for each backend
			nodes=ask-magic,app-server,claude-code
			caption="Codex receives the absolute path as a localImage item. Claude Code receives the file bytes as a base64 image block."
action:
	source=action
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=ask-magic,tool-payload,frontend
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Proposed view, pending review: one insert_cells call. tool_payload checks the cells and each optional after_cell_id against the transcript and this turn's inserts, then the frontend inserts each cell after its anchor and tracks it for run_cells and cell_output."
diff:
	source=diff
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=diff-plugin,fetch-staged,staged-json,staged-cells,paint-diff,align-cells,clear-diff
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Proposed view, pending review: the Diff toolbar button. One press reads the staged cells through the kernel, pairs them with the live cells and paints a right-hand pane in each cell. Edits repaint from the cells read at the press. A second press clears the view. alignCells and staged_json are calls inside their owners, not peers."
	slides:
		read: Step 1 - read the staged cells through the kernel
			nodes=diff-plugin,fetch-staged,staged-json,staged-cells
			caption="The frontend has no git. A silent user_expressions request reaches yukti.staged, which runs git show on the index copy. A notebook outside the index returns no cells, and a folder outside a repository raises."
		paint: Steps 2 to 3 - pair the cells and paint
			nodes=diff-plugin,paint-diff,align-cells
			caption="alignCells pairs cells along their longest common subsequence. Changed cells get an orange outline, added cells green, and deleted cells become red rows. Edits repaint after 300 ms from the cells already read."
		clear: Step 4 - clear
			nodes=diff-plugin,clear-diff
			caption="A second press removes the panes, rows and classes."
