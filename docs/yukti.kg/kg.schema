@graph id=yukti-ask title="One %%ask turn"
hover_attrs=description,code
pair_by=pair
edge_color_by=step
edge_label_from=note
default_view=ask

@sources
nodes=kg.nodes
attrs=kg.attrs
ask:
	edges=kg.edges
transcript:
	edges=kg.transcript.edges
palette=kg.palette
code_source=../../

@relations
sends color=relation.sends
takes color=relation.takes
builds color=relation.builds
streams color=relation.streams
returns color=relation.returns
limits color=relation.limits
closes color=relation.closes

@views
ask:
	source=ask
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=frontend,prefix-comm,ask-magic,app-server
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="Four participants, one round trip. The prefix comm opens before the cell runs and closes after the answer, so its activation bar spans the whole turn. build_transcript and truncate are calls inside %%ask, not participants; the transcript view gives them their own lifelines."
	slides:
		receive: Steps 1 to 2 — take the prefix
			nodes=frontend,prefix-comm,ask-magic
			caption="The frontend sends one notebook_prefix message and does not wait. The comm holds it until the cell starts, then take() hands over the cells and the comm handle at once. An empty comm ends the turn in the break box."
		send: Step 3 — send one bounded request
			nodes=ask-magic,app-server
			caption="build_transcript turns the cells and the question into one string under 512 KB, and %%ask starts a Codex process with it. Open the transcript view to see the two limits that bound it."
		answer: Steps 4 to 6 — stream the answer back
			nodes=app-server,ask-magic,frontend,prefix-comm
			caption="The loop box holds every delta. Each one reaches %%ask first, which decides its block, then reaches the cell through display. A finally block closes the comm, so the frontend learns the turn is over either way."
transcript:
	source=transcript
	layout=sequence
	sequence_role=role
	sequence_phase=phase
	sequence_activation=true
	sequence_lanes=ask-magic,transcript,output-boundary
	sequence_message=message
	sequence_fragment=fragment
	sequence_operand=operand
	sequence_operand_note=operand_note
	color_by=step
	edge_color_by=step
	edge_label_from=note
	hover_attrs=description,code
	caption="A zoom into step 3 of the ask view. Here build_transcript and truncate earn lifelines, because this view is about the calls themselves. Two limits protect one turn: 8 KB per output, then 512 KB for the whole request."
	slides:
		outputs: Step 2 — bound every output
			nodes=transcript,output-boundary
			caption="The loop box runs once per cell above %%ask. Each output is cut to 8 KB before its block joins the request, so one long print cannot crowd out the other cells."
		request: Steps 3 to 4 — bound the whole request
			nodes=ask-magic,transcript,output-boundary
			caption="The blocks are joined, then a second call cuts the joined request to 512 KB. Many small cells can pass the first limit and still add up past this one, which is why both exist."
