t2: transcript -> output-boundary limits
	step=s2
	phase=output
	pair=p-output
	message=sync
	fragment=loop:every cell
	operand=[each cell above %%ask]
	operand_note=Each cell becomes a labelled block holding its source and its output. The output is bounded before the block joins the request, so one long print cannot crowd out the other cells.
	note=truncate(output, 8 KB)
	description=The limit is applied per output, not once at the end. A cell that printed a whole dataframe is cut here.
	code=[build_transcript](../../yukti/context.py){show=symbol symbol=build_transcript kind=Function focus="match[content = truncate(] match[OUTPUT_LIMIT_BYTES]" context=1}
