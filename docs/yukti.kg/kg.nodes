frontend: Notebook frontend
	description=The JupyterLab extension. It sends the cells above %%ask, then shows the answer the kernel renders. Hidden cells are dropped from those cells.
	code=[plugin](../../yukti_frontend/src/index.ts){show=symbol symbol=plugin kind=Variable focus="match[comm.open({]" context=3}
hidden-cells: isHidden
	description=The function that decides whether a cell stays out of the %%ask prompt. A %%yukti cell is hidden by default. The yukti-hidden tag hides any cell, and the yukti-shown tag shows a %%yukti cell. A tag holds an override only, as yukti_wrap does. It is a call inside the frontend, not a peer of it.
	code=[isHidden](../../yukti_frontend/src/index.ts){show=symbol symbol=isHidden kind=Function focus=all}
prefix-comm: Prefix comm
	description=The Jupyter comm that carries one turn. It holds the prefix until %%ask takes it, and stays open until %%ask closes it.
	code=[register_prefix_comm](../../yukti/comm.py){show=symbol symbol=register_prefix_comm kind=Function focus="match[kernel.comm_manager.register_target(COMM_TARGET, cache.open)]" context=2}
ask-magic: %%ask magic
	description=The cell magic that drives the turn. It takes the prefix, builds one bounded transcript, runs the server, and renders every delta.
	code=[YuktiMagics.ask](../../yukti/ask.py){show=symbol symbol=YuktiMagics.ask kind=Method focus="match[= self.prefixes.take()] match[transcript = build_transcript(cells, cell)] match[with backend(root, settings) as server:]" context=1}
app-server: Codex App Server
	description=The Codex process %%ask starts for this turn. It runs the model and streams the answer back.
	code=[AppServer](../../yukti/app_server.py){show=symbol symbol=AppServer kind=Class focus="match[def run(] match[def __exit__(self, *_: Any) -> None:]" context=2}
transcript: build_transcript
	description=The function that turns cells and their outputs into one model transcript. It is a call inside %%ask, not a peer of it.
	code=[build_transcript](../../yukti/context.py){show=symbol symbol=build_transcript kind=Function focus=all}
output-boundary: truncate
	description=The function that holds one string under a byte limit. It keeps the head and the tail, and names how much it cut.
	code=[truncate](../../yukti/context.py){show=symbol symbol=truncate kind=Function focus=all}
settings: parse_settings
	description=The function that reads a %%yukti cell. A backend line picks codex or claude and sets the default model of that backend. A model the backend cannot run is refused. An empty %%yukti cell or %yukti shows the settings table in force (summary). %%yukti help shows the vocabulary (help_text); help_transform rewrites both empty forms to the line magic because IPython refuses an empty cell magic. The key idle_timeout (whole seconds above 0, default 600) sets how long the backend may stay silent (idle-timeout).
	code=[parse_settings](../../yukti/settings.py){show=symbol symbol=parse_settings kind=Function focus="match[BACKENDS[raw][] match[cannot run model]" context=2}
claude-code: Claude Code backend
	description=The class that gives %%ask the same contract as the Codex App Server, over the user's own claude -p process. It reuses the pipe reader and replaces the protocol. Notebook tools stay in the kernel.
	code=[ClaudeCode](../../yukti/claude_code.py){show=symbol symbol=ClaudeCode kind=Class focus="match[class ClaudeCode(AppServer):] match[def run(]" context=2}
	decision=ClaudeCode subclasses AppServer, so the pipe reader, close and the context manager have one owner. workdir() and _open() were extracted from AppServer for this reuse.
subscription-check: require_subscription
	description=The function that stops the turn unless claude auth status reports a Claude subscription login. Anthropic permits subscription use only through the unmodified Claude Code binary. Yukti never reads or forwards the OAuth credential. It starts claude with the default config directory and asks the binary for the login status. Source: https://code.claude.com/docs/en/legal-and-compliance
	policy=Subscription use only through the unmodified claude binary. Yukti never reads, stores or forwards the OAuth credential, and it removes API key and cloud provider variables from the environment so the subscription is billed.
	code=[require_subscription](../../yukti/claude_code.py){show=symbol symbol=require_subscription kind=Function focus="match[AUTH_COMMAND,] match[if not subscription(status):]" context=2}
claude-cli: claude -p process
	description=The user's own signed-in Claude Code CLI. It runs the model and speaks the stream-json control protocol on stdin and stdout. Yukti does not modify it.
	code=[CLAUDE_COMMAND](../../yukti/claude_code.py){show=symbol symbol=CLAUDE_COMMAND kind=Variable focus=all}
tool-item: tool_item
	description=The function that turns a Claude tool_use block into the Codex item shape. tool_line and tool_detail then stay unchanged. It is a call inside ClaudeCode, not a peer of it.
	code=[tool_item](../../yukti/claude_code.py){show=symbol symbol=tool_item kind=Function focus=all}
fence-copy: trackFenceCopies
	description=The function that adds one copy button to the code fence under the pointer, inside the Markdown outputs of %%ask cells only (yukti-ask-cell). The button reuses EDIT_CLASS, the class of the edit-output pencil, so it shows and hides the same way, and FENCE_COPY_CLASS moves it to the bottom right of the fence so it never covers the pencil. A click copies the fence text through Clipboard.copyToSystem and shows a check mark. editOutputPlugin wires it next to trackOutputEdits. It is a call inside the frontend, not a peer of it.
	code=[trackFenceCopies](../../yukti_frontend/src/index.ts){show=symbol symbol=trackFenceCopies kind=Function focus="match[fence.closest(] match[Clipboard.copyToSystem(code)]" context=2}
	decision=The button sits at the bottom right. Pro: one click copies a command without selecting it. Con: a long last line hides a few characters under the button until the pointer leaves.
image-paste: trackImagePastes
	description=The function that turns an image pasted into an %%ask cell into a file and a Markdown reference. It listens for paste in the capture phase, so the editor never pastes the file name as text. saveImage writes the image through the Jupyter contents API as yukti-images/<ISO stamp>.<ext> next to the notebook, then ![](yukti-images/<file>) goes in at the cursor. A paste with no image passes through. editOutputPlugin wires it next to trackFenceCopies. It is a call inside the frontend, not a peer of it.
	code=[trackImagePastes](../../yukti_frontend/src/index.ts){show=symbol symbol=trackImagePastes kind=Function focus="match[saveImage(contents, panel.context.path, file)] match[replaceSelection?.(]" context=2}
	decision=The image is a file, not a cell attachment, because an nbformat code cell has no attachments. The folder is yukti-images, not a dot folder, because jupyter_server refuses hidden paths. Pro: the image survives a rerun and a reload, and the notebook stays small. Con: a notebook copied alone leaves its images behind.
question-images: question_images
	description=The function that returns the Markdown image paths in the %%ask question, in order, with the IMAGE_REFERENCE regex. It is a call inside %%ask, not a peer of it.
	code=[question_images](../../yukti/context.py){show=symbol symbol=question_images kind=Function focus=all}
turn-input: turn_input
	description=The function that builds the turn/start input of the Codex App Server. It is the transcript as a text item, then one localImage item with the absolute path for each image. It is a call inside AppServer, not a peer of it.
	code=[turn_input](../../yukti/app_server.py){show=symbol symbol=turn_input kind=Function focus=all}
user-content: user_content
	description=The function that builds the content of the claude stream-json user message. The CLI reads no image path from a user message, so each file travels as a base64 image block after the text block. A turn with no image keeps the plain string. It is a call inside ClaudeCode, not a peer of it.
	code=[user_content](../../yukti/claude_code.py){show=symbol symbol=user_content kind=Function focus=all}
idle-timeout: AppServer._read
	description=The method that reads one message from the backend stdout. Each call waits at most idle_timeout seconds for the next line. A line resets the wait, so a long turn that keeps streaming never expires. Silence for idle_timeout seconds raises TimeoutError that names the idle_timeout setting. ClaudeCode inherits it. It is a call inside AppServer, not a peer of it.
	code=[AppServer._read](../../yukti/app_server.py){show=symbol symbol=AppServer._read kind=Method focus="match[self._line(time.monotonic() + self.idle_timeout)] match[raise TimeoutError(]" context=3}
	decision=A rolling idle timeout replaces one deadline set when the process opened. The old deadline was now + 300 s and every read used it, so any %%ask turn longer than 5 minutes raised "Claude Code timed out" while it was still streaming. The limit is the %%yukti key idle_timeout (whole seconds above 0, default 600), and the constructor timeout argument is removed from AppServer and ClaudeCode. Pro: only a silent backend is stopped, and the user can raise the limit. Con: a backend that sends a line every few seconds without finishing is never stopped.
